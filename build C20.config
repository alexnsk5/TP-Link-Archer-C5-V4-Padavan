### Target Vendor/Product
CONFIG_VENDOR=TPLINK
CONFIG_PRODUCT=MT7620

### Target ProductID для Archer C20 V1:
CONFIG_FIRMWARE_PRODUCT_ID="TL_C20-V1"

############################################################
### Linux kernel configuration
############################################################
CONFIG_FIRMWARE_CPU_600MHZ=y
CONFIG_FIRMWARE_ENABLE_IPV6=y

### Netfilter / IPSet (для Zapret)
CONFIG_FIRMWARE_INCLUDE_IPSET=y
CONFIG_FIRMWARE_INCLUDE_SHORTCUT_FE=y
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_IP_NF_QUEUE=m

### ВЫКЛЮЧЕНЫ ВСЕ VPN
CONFIG_FIRMWARE_INCLUDE_XFRM=n
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=n
CONFIG_FIRMWARE_INCLUDE_AMNEZIAWG=n
CONFIG_FIRMWARE_INCLUDE_EOIP=n
CONFIG_FIRMWARE_INCLUDE_OPENVPN=n

############################################################
### USB (Полноценная поддержка: модемы + флешки)
############################################################
CONFIG_FIRMWARE_ENABLE_USB=y
CONFIG_FIRMWARE_INCLUDE_MODEM=y

### Файловые системы для флешек/дисков
CONFIG_FIRMWARE_INCLUDE_EXT2=y
CONFIG_FIRMWARE_INCLUDE_EXT3=y
CONFIG_FIRMWARE_INCLUDE_EXT4=y
CONFIG_FIRMWARE_INCLUDE_FAT=y
CONFIG_FIRMWARE_INCLUDE_EXFAT=y
CONFIG_FIRMWARE_INCLUDE_FDISK=y
CONFIG_FIRMWARE_INCLUDE_E2FSPROGS=y

### Выключение ненужных драйверов
CONFIG_FIRMWARE_INCLUDE_UAC=n
CONFIG_FIRMWARE_INCLUDE_UAC3=n
CONFIG_FIRMWARE_INCLUDE_PRINTER=n
CONFIG_FIRMWARE_INCLUDE_XFS=n
CONFIG_FIRMWARE_INCLUDE_NTFS_3G=n

############################################################
### Службы и интерфейс
############################################################
CONFIG_FIRMWARE_INCLUDE_LANG_RU=y
CONFIG_FIRMWARE_INCLUDE_EAP_PEAP=y
CONFIG_FIRMWARE_INCLUDE_DDNS_SSL=y
CONFIG_FIRMWARE_INCLUDE_HTTPS=y
CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y
CONFIG_FIRMWARE_INCLUDE_DROPBEAR_FAST_CODE=y
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EC=y
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EXE=y
CONFIG_FIRMWARE_INCLUDE_WPAD=y
CONFIG_FIRMWARE_INCLUDE_ZRAM=y
CONFIG_FIRMWARE_INCLUDE_CURL=y

### Отключены тяжелые сервисы (экономия 8MB Flash)
CONFIG_FIRMWARE_INCLUDE_SFTP=n
CONFIG_FIRMWARE_INCLUDE_XUPNPD=n
CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=n
CONFIG_FIRMWARE_INCLUDE_ARIA=n
CONFIG_FIRMWARE_INCLUDE_MINIDLNA=n
CONFIG_FIRMWARE_INCLUDE_FIREFLY=n
CONFIG_FIRMWARE_INCLUDE_SMBD=n
CONFIG_FIRMWARE_INCLUDE_NFSD=n

### Безопасный DNS: DoH + DNSCrypt
CONFIG_FIRMWARE_INCLUDE_DOH=y
CONFIG_FIRMWARE_INCLUDE_DNSCRYPT=y

### Zapret (nfqws)
CONFIG_FIRMWARE_INCLUDE_NFQWS=y

### Сжатие размера образа
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
